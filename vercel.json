{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/",
      "dest": "/frontend/index.html"
    },
    {
      "src": "/login",
      "dest": "/frontend/login.html"
    },
    {
      "src": "/signup",
      "dest": "/frontend/signup.html"
    },
    {
      "src": "/dashboard",
      "dest": "/frontend/dashboard.html"
    },
    {
      "src": "/students",
      "dest": "/frontend/students.html"
    },
    {
      "src": "/courses",
      "dest": "/frontend/courses.html"
    },
    {
      "src": "/career",
      "dest": "/frontend/career.html"
    },
    {
      "src": "/roadmap",
      "dest": "/frontend/roadmap.html"
    },
    {
      "src": "/gpa",
      "dest": "/frontend/gpa.html"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ]
}